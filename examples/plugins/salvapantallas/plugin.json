{
  "api": "1.0",
  "id": "salvapantallas",
  "version": "1.0.0",
  "kind": "recipe",
  "min_firmware": "1.6.0",
  "name": {"es": "Salvapantallas", "en": "Screensaver"},
  "summary": {"es": "Tus fotos en la pantalla cuando no la usas. Mándalas al bot o cópialas a la microSD.",
              "en": "Your photos on screen while you are away. Send them to the bot or copy them to the microSD."},
  "author": "Ignacio Aranda",
  "license": "MIT",
  "icon": "photo",
  "category": "reposo",
  "requires": {"sd": "optional"},
  "permissions": ["photos", "sd", "idle"],
  "surfaces": {"page": true, "idle": true},
  "touch": {"longpress": true},
  "commands": [
    {"cmd": "fondo",
     "args": {"es": "[borrar n.º]", "en": "[delete no.]"},
     "desc": {"es": "Fotos del reposo: pon /fondo en el pie de la foto",
              "en": "Idle photos: caption a photo with /fondo"}}
  ],
  "help": {
    "es": "Mándame fotos (sin pie, o con el pie /fondo) y saldrán cuando la pantalla esté en reposo. También vale copiarlas a la carpeta pauta/fotos de la microSD.\n/fondo — cuántas fotos hay.\n/fondo borrar 12 — quita la foto 12.",
    "en": "Send me photos (without a caption, or captioned /fondo) and they will show while the screen is idle. Copying them to the pauta/fotos folder on the microSD works too.\n/fondo — how many photos there are.\n/fondo delete 12 — removes photo 12."
  },
  "settings": {"version": 1, "fields": [
    {"key": "mode", "type": "select", "default": "all",
     "group": {"es": "Qué fotos salen", "en": "Which photos"},
     "label": {"es": "Fotos que salen", "en": "Photos shown"},
     "options": [{"v": "all", "es": "Todas", "en": "All"},
                 {"v": "only", "es": "Solo las elegidas", "en": "Only the chosen ones"},
                 {"v": "except", "es": "Todas menos las elegidas", "en": "All but the chosen ones"}]},
    {"key": "picked", "type": "multiselect", "options_from": "runtime.photos", "max": 64,
     "pattern": "^[a-z2-7]{6}$", "keep_hidden": true, "visible_if": {"mode": ["only", "except"]},
     "group": {"es": "Qué fotos salen", "en": "Which photos"},
     "label": {"es": "Elegidas", "en": "Chosen"},
     "help": {"es": "Por número, fecha y pie de foto (salen las 64 más recientes). «Verlas en el chat» te manda las del bot.",
              "en": "By number, date and caption (the 64 most recent). «See them in the chat» sends you the bot ones."}},
    {"key": "src", "type": "select", "default": "both",
     "group": {"es": "Qué fotos salen", "en": "Which photos"},
     "label": {"es": "De dónde", "en": "From"},
     "options": [{"v": "both", "es": "Del bot y de la tarjeta", "en": "From the bot and the card"},
                 {"v": "bot", "es": "Solo las del bot", "en": "Only the bot ones"},
                 {"v": "sd", "es": "Solo las de la tarjeta", "en": "Only the card ones"}]},
    {"key": "albums", "type": "multiselect", "options_from": "runtime.albums", "max": 16,
     "pattern": "^[a-z2-7]{6}$", "visible_if": {"src": ["both", "sd"]},
     "group": {"es": "Qué fotos salen", "en": "Which photos"},
     "label": {"es": "Álbumes de la tarjeta", "en": "Card albums"},
     "help": {"es": "Las subcarpetas de pauta/fotos. Sin marcar ninguno, salen todas.",
              "en": "The subfolders of pauta/fotos. With none ticked, all of them show."}},
    {"key": "new_auto", "type": "bool", "default": true,
     "group": {"es": "Qué fotos salen", "en": "Which photos"},
     "label": {"es": "Las fotos nuevas salen solas", "en": "New photos join on their own"},
     "help": {"es": "Si lo apagas, una foto nueva no sale hasta que la veas en la página del plugin.",
              "en": "If off, a new photo is not shown until you see it on the plugin page."}},
    {"key": "every_s", "type": "duration", "min": 10, "max": 3600, "default": 60,
     "group": {"es": "Cómo salen", "en": "How they show"},
     "label": {"es": "Cambiar cada", "en": "Change every"}},
    {"key": "order", "type": "select", "default": "random",
     "group": {"es": "Cómo salen", "en": "How they show"},
     "label": {"es": "Orden", "en": "Order"},
     "options": [{"v": "random", "es": "Al azar, sin repetir", "en": "Shuffled, no repeats"},
                 {"v": "newest", "es": "Primero las más nuevas", "en": "Newest first"},
                 {"v": "oldest", "es": "Primero las más antiguas", "en": "Oldest first"}]},
    {"key": "fit", "type": "select", "default": "fill",
     "group": {"es": "Cómo salen", "en": "How they show"},
     "label": {"es": "Encaje", "en": "Fit"},
     "options": [{"v": "fill", "es": "Llenar la pantalla (recorta)", "en": "Fill the screen (crops)"},
                 {"v": "fit", "es": "Foto entera (con bandas)", "en": "Whole photo (with bars)"}]},
    {"key": "overlay", "type": "select", "default": "clock_weather",
     "group": {"es": "Cómo salen", "en": "How they show"},
     "label": {"es": "Encima de la foto", "en": "On top of the photo"},
     "help": {"es": "Las cuentas en marcha, como el Pomodoro, salen siempre en una faja si así lo dice Sistema.",
              "en": "Running counters, like the Pomodoro, always show in a strip if System says so."},
     "options": [{"v": "none", "es": "Nada", "en": "Nothing"},
                 {"v": "clock", "es": "La hora", "en": "The time"},
                 {"v": "clock_weather", "es": "Hora, fecha y tiempo", "en": "Time, date and weather"}]},
    {"key": "overlay_pos", "type": "select", "default": "bottom",
     "visible_if": {"overlay": ["clock", "clock_weather"]},
     "group": {"es": "Cómo salen", "en": "How they show"},
     "label": {"es": "Dónde", "en": "Where"},
     "options": [{"v": "bottom", "es": "Abajo", "en": "Bottom"},
                 {"v": "top", "es": "Arriba", "en": "Top"}]},
    {"key": "night", "type": "select", "default": "photos",
     "group": {"es": "Cómo salen", "en": "How they show"},
     "label": {"es": "En la franja de noche", "en": "During the night window"},
     "options": [{"v": "photos", "es": "Fotos", "en": "Photos"},
                 {"v": "clock", "es": "Solo el reloj", "en": "Clock only"}]},
    {"key": "when_full", "type": "select", "default": "oldest",
     "group": {"es": "Fotos del bot", "en": "Bot photos"},
     "label": {"es": "Si no caben más", "en": "When full"},
     "options": [{"v": "oldest", "es": "Borrar la más antigua", "en": "Delete the oldest"},
                 {"v": "refuse", "es": "No guardar la nueva", "en": "Do not keep the new one"}]},
    {"key": "confirm", "type": "bool", "default": true,
     "group": {"es": "Fotos del bot", "en": "Bot photos"},
     "label": {"es": "Confirmar cada foto en el chat", "en": "Confirm each photo in the chat"}}
  ]},
  "actions": [
    {"id": "delete", "confirm": "screen",
     "label": {"es": "Borrar fotos", "en": "Delete photos"},
     "args": [{"key": "names", "type": "multiselect", "options_from": "runtime.photos", "options_if": {"src": "bot"},
               "pattern": "^[a-z2-7]{6}$", "max": 64, "required": true,
               "label": {"es": "Fotos que borrar", "en": "Photos to delete"},
               "help": {"es": "Solo las del bot: las de la carpeta fotos de la tarjeta se borran desde el PC.",
                        "en": "Only the bot ones: photos in the card's fotos folder are deleted from the PC."}}]},
    {"id": "send", "confirm": false,
     "label": {"es": "Verlas en el chat", "en": "See them in the chat"},
     "args": [{"key": "names", "type": "multiselect", "options_from": "runtime.photos", "options_if": {"src": "bot"},
               "pattern": "^[a-z2-7]{6}$", "max": 10, "required": true,
               "label": {"es": "Fotos (10 como mucho)", "en": "Photos (10 at most)"}}]},
    {"id": "preview", "confirm": false,
     "label": {"es": "Probar el reposo ahora", "en": "Try idle mode now"},
     "args": []}
  ],
  "runtime": [{"name": "photos", "max": 64, "item_max": 24, "label": "{n} · {at} · {cap}",
               "cols": [{"key": "n", "type": "int"}, {"key": "at", "type": "date"},
                        {"key": "cap", "type": "text"}, {"key": "src", "type": "tag"}]},
              {"name": "albums", "max": 16, "item_max": 24, "pairs": true}],
  "memory": {"psram_kb": 160, "static_kb": 0},
  "storage": {"state_kb": 4, "data_kb": 4096, "sd_mb": 1024, "sd_shared": "fotos"},
  "recipe": {
    "format": 1,
    "engines": {
      "photos": {
        "max_bot": 40,
        "when_full": "{{cfg.when_full}}",
        "caption_cmd": "fondo",
        "shared": true,
        "reply": "{{cfg.confirm}}",
        "new_auto": "{{cfg.new_auto}}",
        "publish": {"photos": "photos", "albums": "albums"}
      },
      "slideshow": {
        "from": "photos",
        "mode": "{{cfg.mode}}",
        "picked": "{{cfg.picked}}",
        "src": "{{cfg.src}}",
        "albums": "{{cfg.albums}}",
        "every": "{{cfg.every_s}}s",
        "order": "{{cfg.order}}",
        "fit": "{{cfg.fit}}",
        "transition": "fade",
        "overlay": "{{cfg.overlay}}",
        "overlay_pos": "{{cfg.overlay_pos}}",
        "night": "{{cfg.night}}"
      }
    },
    "idle": {"from": "slideshow"},
    "header": {
      "subtitle": [
        {"if": [["photos.sd", "gt", 0]], "v": {"es": "{{photos.count}} FOTOS · {{photos.sd}} EN LA TARJETA",
                                                "en": "{{photos.count}} PHOTOS · {{photos.sd}} ON THE CARD"}},
        {"v": {"es": "{{photos.count}} FOTOS", "en": "{{photos.count}} PHOTOS"}}
      ]
    },
    "footer": {
      "label": {"es": "PROBAR REPOSO", "en": "TRY IDLE"},
      "do": [{"do": "idle.preview"}]
    },
    "views": [
      {
        "id": "main",
        "blocks": [
          {"type": "image", "w": "left", "h": 138, "src": "slideshow.current", "fit": "{{cfg.fit}}",
           "empty": {"es": "Sin fotos todavía", "en": "No photos yet"},
           "confirm": "twice", "confirm_label": {"es": "¿BORRARLA? MANTÉN OTRA VEZ", "en": "DELETE IT? HOLD AGAIN"},
           "long": [{"do": "photos.delete_current"}]},
          {"type": "list", "w": "right", "h": 138, "items": "photos.latest",
           "row": {"label": "{{item.label}}", "value": "{{item.at|date}}"},
           "empty": {"es": "Mándale una foto al bot", "en": "Send the bot a photo"}},
          {"type": "text", "h": 46, "font": "meta13", "tone": "mute", "align": "left",
           "text": {"es": "MANTÉN LA FOTO DOS VECES PARA BORRARLA", "en": "HOLD THE PHOTO TWICE TO DELETE IT"}}
        ]
      }
    ],
    "on": {
      "command.fondo": [
        {"do": "photos.delete", "if": [["ev.w1", "in", ["borrar", "delete"]], ["ev.n", "set"]], "number": "{{ev.n}}"},
        {"do": "reply", "if": [["ev.w1", "unset"]],
         "text": {"es": "Tengo {{photos.count}} fotos ({{photos.bot}} del bot y {{photos.sd}} de la tarjeta). Mándame una foto con el pie /fondo para añadirla, o escribe /fondo borrar 12 para quitar la 12.",
                  "en": "I have {{photos.count}} photos ({{photos.bot}} from the bot and {{photos.sd}} from the card). Send me a photo captioned /fondo to add it, or type /fondo delete 12 to remove number 12."}},
        {"do": "reply", "if": [["ev.w1", "set"], ["ev.n", "unset"]],
         "text": {"es": "Escribe /fondo o /fondo borrar 12.", "en": "Type /fondo or /fondo delete 12."}},
        {"do": "reply", "if": [["ev.w1", "nin", ["borrar", "delete"]], ["ev.n", "set"]],
         "text": {"es": "Para quitar la foto {{ev.n}}, escribe /fondo borrar {{ev.n}}.", "en": "To remove photo {{ev.n}}, type /fondo delete {{ev.n}}."}}
      ],
      "action.delete": [{"do": "photos.delete", "ids": "{{ev.args.names}}"}],
      "action.send": [{"do": "photos.send", "ids": "{{ev.args.names}}"}],
      "action.preview": [{"do": "idle.preview"}]
    }
  }
}
