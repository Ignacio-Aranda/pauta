{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ignacio-Aranda/pauta/main/schemas/miniapp-message.schema.json",
  "title": "Pauta Plugin API 1.0: envío de la Mini App a la placa (sendData)",
  "description": "La parte JSON de Telegram.WebApp.sendData() (docs/plugins-referencia.md, apartado 9.5). Todo envío salvo la petición de emparejar termina con un salto de línea y la firma: HMAC-SHA256 de los bytes UTF-8 del JSON tal cual se manda (hasta el último salto de línea, sin incluirlo), recortado a 16 bytes y en base64url (22 caracteres), con la clave propia del dispositivo Ksend = HKDF-SHA256(Kdev, sal = SHA-256(k), info = 'pauta-send-v1|<d>'). La firma no forma parte de este JSON. Vectores de prueba en examples/wire/vectors.json. Tope: 4096 bytes con la firma, 32 operaciones. Una operación, un campo o una 'v' desconocidos hacen rechazar el envío entero.",
  "type": "object",
  "required": ["v", "id", "base", "t", "ops"],
  "properties": {
    "v": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z2-7]{8}$", "description": "Identificador del envío, para descartar repeticiones (la placa recuerda los 16 últimos)."},
    "d": {"$ref": "manifest.schema.json#/$defs/itemId", "description": "Dispositivo emparejado que firma. Falta solo en 'pair'."},
    "base": {"type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Revisión con la que se abrió la Mini App."},
    "t": {"type": "integer", "minimum": 1700000000, "description": "Hora del envío (segundos Unix). Las acciones se descartan con más de 10 minutos."},
    "ops": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/op"}}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "'pair' va solo y sin dispositivo (todavía no tiene clave para firmar). El resto lleva 'd'.",
      "if": {"properties": {"ops": {"contains": {"properties": {"op": {"const": "pair"}}, "required": ["op"]}}}},
      "then": {"properties": {"ops": {"maxItems": 1}}, "not": {"required": ["d"]}},
      "else": {"required": ["d"]}
    }
  ],
  "$defs": {
    "pid": {"$ref": "manifest.schema.json#/$defs/pluginId"},
    "key": {"$ref": "manifest.schema.json#/$defs/key"},
    "itemId": {"$ref": "manifest.schema.json#/$defs/itemId"},
    "box": {
      "description": "Sobre sellado: base64url(clave de un solo uso 65 B | vector 12 B | cifrado | etiqueta 16 B). El texto en claro va relleno con 0x00 hasta 16 B (PIN) o hasta el múltiplo de 32 siguiente (secretos, 128 como mucho): 146 caracteres el PIN y de 167 a 295 un secreto. null borra el secreto.",
      "anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9_-]{146,295}$"}, {"type": "null"}]
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": {"$ref": "manifest.schema.json#/$defs/key"}
    },
    "op": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"enum": ["sys", "enable", "order", "cfg", "item.add", "item.set", "item.del", "item.order", "secret",
                        "action", "open", "reset", "accept", "revoke", "install", "remove", "pair", "unpair"]}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "sys"}}}, "then": {
          "properties": {
            "set": {"allOf": [{"$ref": "#/$defs/values"}, {"$ref": "url-state.schema.json#/$defs/sys"},
                              {"not": {"required": ["pin"]}}]},
            "box": {"type": "object", "required": ["pin"], "properties": {"pin": {"$ref": "#/$defs/box"}}, "additionalProperties": false},
            "act": {
              "type": "object",
              "required": ["a"],
              "properties": {
                "a": {"enum": ["ota.check", "ota.install", "safe.exit"]},
                "ver": {"$ref": "manifest.schema.json#/$defs/semver"}
              },
              "additionalProperties": false
            }
          },
          "anyOf": [{"required": ["set"]}, {"required": ["box"]}, {"required": ["act"]}]}},
        {"if": {"properties": {"op": {"const": "enable"}}}, "then": {"required": ["p", "on"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "on": {"type": "boolean"}}}},
        {"if": {"properties": {"op": {"const": "order"}}}, "then": {"required": ["ids"], "properties": {
          "ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/pid"}}}}},
        {"if": {"properties": {"op": {"const": "cfg"}}}, "then": {"required": ["p", "set"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "set": {"$ref": "#/$defs/values"}}}},
        {"if": {"properties": {"op": {"const": "item.add"}}}, "then": {"required": ["p", "f", "id", "val"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "f": {"$ref": "#/$defs/key"}, "id": {"$ref": "#/$defs/itemId"},
          "val": {"type": "object", "maxProperties": 12, "propertyNames": {"$ref": "manifest.schema.json#/$defs/key"}}}}},
        {"if": {"properties": {"op": {"const": "item.set"}}}, "then": {"required": ["p", "f", "id", "val"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "f": {"$ref": "#/$defs/key"}, "id": {"$ref": "#/$defs/itemId"},
          "val": {"type": "object", "minProperties": 1, "maxProperties": 12, "propertyNames": {"$ref": "manifest.schema.json#/$defs/key"}}}}},
        {"if": {"properties": {"op": {"const": "item.del"}}}, "then": {"required": ["p", "f", "id"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "f": {"$ref": "#/$defs/key"}, "id": {"$ref": "#/$defs/itemId"}}}},
        {"if": {"properties": {"op": {"const": "item.order"}}}, "then": {"required": ["p", "f", "ids"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "f": {"$ref": "#/$defs/key"},
          "ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/itemId"}}}}},
        {"if": {"properties": {"op": {"const": "secret"}}}, "then": {"required": ["p", "f", "box"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "f": {"$ref": "#/$defs/key"}, "box": {"$ref": "#/$defs/box"}}}},
        {"if": {"properties": {"op": {"const": "action"}}}, "then": {"required": ["p", "a"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "a": {"$ref": "#/$defs/key"},
          "args": {"type": "object", "maxProperties": 4, "propertyNames": {"$ref": "manifest.schema.json#/$defs/key"}}}}},
        {"if": {"properties": {"op": {"const": "open"}}}, "then": {"required": ["p"], "properties": {
          "p": {"$ref": "#/$defs/pid"},
          "f": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "string", "pattern": "^rt\\.[a-z][a-z0-9_]{0,15}$"}], "description": "La lista de ajustes, o rt.<nombre> para una lista de la placa."},
          "o": {"type": "integer", "minimum": 0, "maximum": 63}},
          "dependentRequired": {"o": ["f"]}}},
        {"if": {"properties": {"op": {"const": "reset"}}}, "then": {"required": ["p"], "properties": {
          "p": {"$ref": "#/$defs/pid"}}}},
        {"if": {"properties": {"op": {"const": "accept"}}}, "then": {"required": ["p", "perm"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "perm": {"type": "string", "pattern": "^[0-9a-f]{8}$", "description": "Huella de permisos que el dueño ha visto."}}}},
        {"if": {"properties": {"op": {"const": "revoke"}}}, "then": {"required": ["p", "perm"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "perm": {"$ref": "manifest.schema.json#/$defs/permission", "description": "Permiso opcional concedido que se quita. No pide toque: solo quita."}}}},
        {"if": {"properties": {"op": {"const": "install"}}}, "then": {"required": ["p", "ver", "sha"], "properties": {
          "p": {"$ref": "#/$defs/pid"}, "ver": {"$ref": "manifest.schema.json#/$defs/semver"},
          "sha": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "16 primeros hex del SHA-256 del archivo de la receta, como figura en el índice firmado."}}}},
        {"if": {"properties": {"op": {"const": "remove"}}}, "then": {"required": ["p"], "properties": {
          "p": {"$ref": "#/$defs/pid"}}}},
        {"if": {"properties": {"op": {"const": "pair"}}}, "then": {"required": ["dev", "name", "pk"], "properties": {
          "dev": {"$ref": "#/$defs/itemId"},
          "name": {"type": "string", "minLength": 1, "maxLength": 16},
          "pk": {"type": "string", "pattern": "^[A-Za-z0-9_-]{87}$", "description": "Clave pública ECDH P-256 temporal del dispositivo (65 bytes)."}}}},
        {"if": {"properties": {"op": {"const": "unpair"}}}, "then": {"required": ["dev"], "properties": {
          "dev": {"anyOf": [{"$ref": "#/$defs/itemId"}, {"const": "*"}]}}}}
      ],
      "unevaluatedProperties": false
    }
  }
}
