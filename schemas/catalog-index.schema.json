{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ignacio-Aranda/pauta/main/schemas/catalog-index.schema.json",
  "title": "Pauta Plugin API 1.0: índice del catálogo (catalog/v1/index.json)",
  "description": "Índice estático que publica GitHub Pages (docs/plugins-referencia.md, apartado 11). Lo genera y lo firma la GitHub Action: index.json.sig es la firma ECDSA P-256 (r||s, 64 bytes, en base64url) de los bytes exactos de index.json. La placa solo instala recetas cuyo archivo coincide con el sha256 de este índice firmado, y rechaza un 'seq' menor que el último que vio. La Mini App lo usa para las fichas, incluidos los nativos (que no se descargan: llegan con el firmware). Tope: 32 KB.",
  "type": "object",
  "required": ["catalog", "seq", "generated", "key", "plugins"],
  "properties": {
    "catalog": {"const": 1},
    "seq": {"type": "integer", "minimum": 1, "maximum": 4294967295, "description": "Sube con cada publicación."},
    "generated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "key": {"enum": ["cat1", "cat2"], "description": "Cuál de las dos claves públicas del catálogo compiladas en el firmware firma este índice."},
    "base": {"type": "string", "pattern": "^https://[a-z0-9.-]+/[A-Za-z0-9._/-]*/$", "description": "Prefijo de las rutas 'file' y 'shot'. Por defecto, la carpeta del propio índice."},
    "plugins": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/entry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "kind", "version", "api", "min_firmware", "name", "summary", "icon", "author", "license", "permissions"],
      "properties": {
        "id": {"$ref": "manifest.schema.json#/$defs/pluginId"},
        "kind": {"enum": ["native", "recipe"]},
        "version": {"$ref": "manifest.schema.json#/$defs/semver"},
        "api": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]{0,2})$"},
        "min_firmware": {"$ref": "manifest.schema.json#/$defs/semver"},
        "bundled": {"$ref": "manifest.schema.json#/$defs/semver", "description": "Primer firmware que la trae de serie (nativos y recetas incluidas)."},
        "name": {"$ref": "manifest.schema.json#/$defs/bi16"},
        "summary": {"$ref": "manifest.schema.json#/$defs/bi120"},
        "icon": {"$ref": "manifest.schema.json#/$defs/iconName"},
        "category": {"enum": ["trabajo", "casa", "reposo", "herramientas", "comunicacion"]},
        "author": {"type": "string", "minLength": 1, "maxLength": 40},
        "license": {"type": "string", "pattern": "^[A-Za-z0-9.+-]{1,40}$"},
        "permissions": {"$ref": "manifest.schema.json#/$defs/permissionList"},
        "optional_permissions": {"$ref": "manifest.schema.json#/$defs/permissionList"},
        "hosts": {"type": "array", "maxItems": 8, "items": {"$ref": "manifest.schema.json#/$defs/hostname"},
                  "description": "Los hosts fijos de net.hosts, para la ficha."},
        "user_hosts": {"type": "boolean", "description": "Se conecta a las webs que pone el dueño (net.user)."},
        "requires": {"$ref": "manifest.schema.json#/properties/requires"},
        "attribution": {"$ref": "manifest.schema.json#/$defs/bi60"},
        "file": {"type": "string", "pattern": "^p/[a-z][a-z0-9-]{1,23}/(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.json$",
                 "description": "Ruta de la receta, que no cambia nunca: p/<id>/<versión>.json."},
        "bytes": {"type": "integer", "minimum": 64, "maximum": 16384},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "perm": {"type": "string", "pattern": "^[0-9a-f]{8}$", "description": "Huella de permisos (CRC32 de permisos, net y mqtt)."},
        "shot": {"type": "string", "pattern": "^p/[a-z][a-z0-9-]{1,23}/[A-Za-z0-9._-]{1,64}\\.png$"},
        "hidden": {"type": "boolean", "description": "No sale en la lista; se instala con un enlace."},
        "flags": {
          "type": "array", "uniqueItems": true, "maxItems": 6,
          "items": {"enum": ["tasks_read_net", "personal_use", "needs_key", "needs_lan", "unofficial_api", "needs_sd"]}
        }
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"kind": {"const": "recipe"}}},
         "then": {"required": ["file", "bytes", "sha256", "perm"]},
         "else": {"required": ["bundled"], "properties": {"file": false, "bytes": false, "sha256": false}}}
      ]
    }
  }
}
